{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/mraf/config.schema.json",
  "title": "Neer Kaavalan configuration",
  "description": "Configuration accepted by POST /api/config on the ESP32 firmware and the native simulator.",
  "type": "object",
  "required": ["device", "wifi", "channels", "pump", "safety"],
  "additionalProperties": true,
  "properties": {
    "device": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "name": {"type": "string", "maxLength": 39},
        "heading": {"type": "string", "maxLength": 63, "default": "நீர்காவலன்"},
        "subheading": {"type": "string", "maxLength": 95, "description": "Empty falls back to the device name."},
        "timezone": {"type": "string", "maxLength": 15, "default": "IST-5:30"},
        "auth_user": {"type": "string", "maxLength": 19, "default": "admin"},
        "auth_pass": {"type": "string", "maxLength": 31, "description": "Write-only; omitted from GET responses."},
        "profile": {"type": "string", "maxLength": 23, "pattern": "^[a-z][a-z0-9_-]*$", "description": "Built-in profile or custom slug from the Profiles tab."}
      }
    },
    "relay_count": {"type": "integer", "minimum": 1, "maximum": 12, "default": 12,
      "description": "Number of active relays; channels/status are trimmed to this length."},
    "pins": {
      "type": "object",
      "description": "Runtime ESP32-WROOM output map for the active relays and pump starter.",
      "properties": {
        "relays": {"type": "array", "minItems": 1, "maxItems": 12,
          "items": {"type": "integer", "minimum": 0, "maximum": 39}},
        "relays_off": {"type": "array", "minItems": 1, "maxItems": 12,
          "description": "Optional STOP/contactor GPIO per relay; equal to relays[i] when unused.",
          "items": {"type": "integer", "minimum": 0, "maximum": 39}},
        "pump": {"type": "integer", "minimum": 0, "maximum": 39, "default": 33,
          "description": "Pump starter START pulse GPIO; 0 removes the starter (dryland farming)."},
        "pump_off": {"type": "integer", "minimum": 0, "maximum": 39, "default": 15,
          "description": "Pump starter STOP pulse GPIO; must differ from pump. Always pulse-driven."}
      }
    },
    "profiles": {
      "type": "array",
      "description": "Profile library edited in the Profiles tab (persisted by the simulator).",
      "items": {
        "type": "object",
        "required": ["id", "pins", "channels"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z][a-z0-9_-]{0,22}$"},
          "relay_count": {"type": "integer", "minimum": 1, "maximum": 12},
          "name": {"type": "string", "maxLength": 39},
          "unit": {"type": "string", "maxLength": 15},
          "pins": {"type": "object"},
          "channels": {"type": "array", "maxItems": 12}
        }
      }
    },
    "wifi": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "ssid": {"type": "string", "maxLength": 32},
        "password": {"type": "string", "maxLength": 64, "description": "Write-only; omitted from GET responses."},
        "hostname": {"type": "string", "maxLength": 32, "default": "mraf"}
      }
    },
    "coap": {
      "type": "object",
      "additionalProperties": true,
      "description": "Remote Java server polling over CoAP/UDP.",
      "properties": {
        "enabled": {"type": "boolean", "default": false},
        "host": {"type": "string", "maxLength": 63, "description": "Hostname or IPv4 address of the CoAP server."},
        "port": {"type": "integer", "minimum": 1, "maximum": 65535, "default": 5683},
        "path": {"type": "string", "maxLength": 31, "pattern": "^/", "default": "/mraf"},
        "interval_sec": {"type": "integer", "minimum": 10, "maximum": 3600, "default": 30},
        "token": {"type": "string", "maxLength": 47, "description": "Write-only shared token; omitted from GET responses."}
      }
    },
    "wireguard": {
      "type": "object",
      "additionalProperties": true,
      "description": "WireGuard overlay applied when the server sends a WIREGUARD CoAP request. Key material is write-only.",
      "properties": {
        "enabled": {"type": "boolean", "default": false},
        "interface": {"type": "string", "maxLength": 15, "default": "wg0"},
        "address": {"type": "string", "maxLength": 31, "description": "Device overlay address, e.g. 10.66.66.2/32"},
        "dns": {"type": "string", "maxLength": 63},
        "private_key": {"type": "string", "maxLength": 63, "description": "Write-only Curve25519 private key; omitted from GET responses."},
        "peer_public_key": {"type": "string", "maxLength": 63},
        "peer_endpoint": {"type": "string", "maxLength": 63, "description": "Server endpoint host:port"},
        "peer_allowed_ips": {"type": "string", "maxLength": 63, "description": "Comma-separated CIDRs routed through the tunnel"},
        "peer_preshared_key": {"type": "string", "maxLength": 63, "description": "Write-only optional preshared key; omitted from GET responses."},
        "persistent_keepalive": {"type": "integer", "minimum": 0, "maximum": 3600, "default": 25}
      }
    },
    "webrtc": {
      "type": "object",
      "additionalProperties": true,
      "description": "Peer-to-peer data channel served directly by the device. The browser reads its settings from GET /api/webrtc on the device; the Spring Boot server only relays the SDP/ICE handshake and runs the STUN server.",
      "properties": {
        "enabled": {"type": "boolean", "default": false},
        "server": {"type": "string", "maxLength": 63, "description": "Control-plane base URL, e.g. http://10.0.0.5:8085"},
        "stun": {"type": "string", "maxLength": 63, "description": "Optional STUN URL override, e.g. stun:10.0.0.5:3478. Discovered from the server when empty."},
        "turn": {"type": "string", "maxLength": 95, "description": "Optional TURN relay URL override, e.g. turn:10.0.0.5:3478. Discovered from the server when empty; used as the fallback when a direct/STUN path is unreachable."},
        "turn_user": {"type": "string", "maxLength": 47, "description": "TURN long-term credential username. Discovered from the server when empty."},
        "turn_pass": {"type": "string", "maxLength": 63, "description": "TURN long-term credential password. Never returned by GET /api/config."},
        "poll_ms": {"type": "integer", "minimum": 100, "maximum": 5000, "default": 400}
      }
    },
    "channels": {
      "type": "array",
      "minItems": 1,
      "maxItems": 12,
      "description": "Missing channels are padded with disabled spares.",
      "items": {
        "type": "object",
        "required": ["name", "enabled", "days", "mode", "windows"],
        "additionalProperties": true,
        "properties": {
          "id": {"type": "integer", "minimum": 1, "maximum": 12},
          "name": {"type": "string", "maxLength": 23},
          "enabled": {"type": "boolean"},
          "days": {"type": "integer", "minimum": 0, "maximum": 127, "description": "bit0=Mon ... bit6=Sun"},
          "mode": {"enum": ["auto", "on", "off"]},
          "windows": {
            "type": "array",
            "maxItems": 4,
            "items": {"$ref": "#/$defs/window"}
          }
        }
      }
    },
    "pump": {
      "type": "object",
      "required": ["name", "enabled", "days", "mode", "windows"],
      "additionalProperties": true,
      "properties": {
        "name": {"type": "string", "maxLength": 23},
        "enabled": {"type": "boolean"},
        "days": {"type": "integer", "minimum": 0, "maximum": 127},
        "mode": {"enum": ["auto", "on", "off"]},
        "windows": {
          "type": "array",
          "maxItems": 4,
          "items": {"$ref": "#/$defs/window"}
        },
        "min_off_sec": {"type": "integer", "minimum": 30, "maximum": 3600, "default": 300},
        "max_run_min": {"type": "integer", "minimum": 1, "maximum": 720, "default": 120},
        "recovery_delay_sec": {"type": "integer", "minimum": 0, "maximum": 600, "default": 30},
        "resume_after_outage": {"type": "boolean", "default": true},
        "dry_run_current_a": {"type": "number", "minimum": 0.5, "maximum": 20, "default": 1.5},
        "dry_run_grace_sec": {"type": "integer", "minimum": 5, "maximum": 120, "default": 20},
        "tank_full_active_low": {"type": "boolean", "default": true},
        "sump_dry_active_low": {"type": "boolean", "default": true}
      }
    },
    "safety": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "max_boost_min": {"type": "integer", "minimum": 1, "maximum": 1440, "default": 180}
      }
    }
  },
  "$defs": {
    "window": {
      "type": "object",
      "required": ["on", "off"],
      "additionalProperties": false,
      "properties": {
        "on": {"type": "string", "pattern": "^([01]?[0-9]|2[0-3]):[0-5][0-9]$"},
        "off": {"type": "string", "pattern": "^([01]?[0-9]|2[0-3]):[0-5][0-9]$"}
      }
    }
  }
}
